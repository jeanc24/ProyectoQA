{
  "realm": "inventory",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "client": {
      "inventory-api": [
        {
          "name": "product:view",
          "description": "Read products",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "product:manage",
          "description": "Create, update and delete products",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "stock:view",
          "description": "View stock levels and movement history",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "stock:manage",
          "description": "Register stock entries, exits and adjustments",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "report:view",
          "description": "View reports and dashboard metrics",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "audit:view",
          "description": "View product audit / revision history",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "user:manage",
          "description": "Manage application users (reserved for admin operations)",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API",
      "enabled": true,
      "publicClient": false,
      "secret": "inventory-api-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
