# Stack Security (ZAP / smoke en Jenkins) — copiar a `.env.security` (gitignored).
#   cp .env.security.example .env.security
#   docker compose -f docker-compose.security.yml --env-file .env.security up -d --build
#
# Puertos distintos al .env de desarrollo (8080/8081/5433) a propósito.

# --- Postgres (compartido con demo; cambiar en uso real) ---
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
SECURITY_POSTGRES_HOST_PORT=5435

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=inventory-api
KEYCLOAK_CLIENT_SECRET=inventory-api-secret
SECURITY_KEYCLOAK_HOST_PORT=8091
SECURITY_KEYCLOAK_HOSTNAME=http://localhost:8091
SECURITY_KEYCLOAK_ISSUER_URI=http://localhost:8091/realms/inventory

# --- API ---
SECURITY_API_HOST_PORT=8090
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_JWK_SET_URI=http://keycloak:8080/realms/inventory/protocol/openid-connect/certs
