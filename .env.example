# Desarrollo local — copiar a `.env` (gitignored). No commitear `.env`.
#   cp .env.example .env
#   docker compose --env-file .env up -d --build
#
# DEMO ONLY: valores de abajo sirven para levantar el stack académico.
# Deben coincidir con keycloak/inventory-realm.json.
# Staging/prod: .env.staging.example / .env.production.example → change-me-*
# Tokens personales (NVD/SONAR) solo en tu .env local o en GitHub/Jenkins Secrets.
# Opcional en GitHub Actions: secrets KEYCLOAK_CLIENT_SECRET, KEYCLOAK_ADMIN, KEYCLOAK_ADMIN_PASSWORD
# (si faltan, CI usa los defaults demo vía scripts/lib/load-env.sh).

# --- Postgres ---
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_HOST_PORT=5433

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/inventory
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_CLIENT_ID=inventory-api
KEYCLOAK_CLIENT_SECRET=inventory-api-secret
# Admin REST vista desde el contenedor API (red Docker)
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=inventory

# --- API ---
API_HOST_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_JWK_SET_URI=http://keycloak:8080/realms/inventory/protocol/openid-connect/certs

# --- Frontend (build-time Vite en la imagen Docker) ---
FRONTEND_HOST_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=inventory
VITE_KEYCLOAK_CLIENT_ID=inventory-frontend

# --- Observabilidad ---
TEMPO_HOST_PORT=3200
LOKI_HOST_PORT=3100
ALLOY_OTLP_GRPC_PORT=4317
ALLOY_OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12345
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

OTEL_TRACES_SAMPLING=1.0
OTEL_TRACES_ENDPOINT=http://alloy:4318/v1/traces
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_METRICS_EXPORT_URL=http://alloy:4318/v1/metrics

# --- Jenkins (opcional) ---
JENKINS_HTTP_PORT=8082
JENKINS_AGENT_PORT=50000

# --- E2E Playwright (opcionales; defaults = usuarios demo del realm) ---
# KEYCLOAK_REALM=inventory
# E2E_ADMIN_USER=admin
# E2E_ADMIN_PASSWORD=admin
# E2E_VIEWER_USER=viewer
# E2E_VIEWER_PASSWORD=viewer
# E2E_STOCK_MANAGER_USER=stock-manager
# E2E_STOCK_MANAGER_PASSWORD=stock-manager
# E2E_AUDITOR_USER=auditor
# E2E_AUDITOR_PASSWORD=auditor

# --- CI / calidad (opcionales; no los pongas en git) ---
# NVD_API_KEY=
# SONAR_TOKEN=

# Stack Security (ZAP/Jenkins): ver `.env.security.example`
#   cp .env.security.example .env.security
