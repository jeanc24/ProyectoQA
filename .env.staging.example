# ENV-01 — Staging (copiar a .env.staging y ajustar). No commitear .env.staging.
# Uso:
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build

# --- Postgres ---
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-staging-db
POSTGRES_HOST_PORT=5434

# --- Keycloak (admin consola IdP) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_HOST_PORT=8181
# Issuer visto por el navegador / JWT (puerto publicado)
KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/inventory
# Hostname anunciado por Keycloak (debe coincidir con KEYCLOAK_ISSUER_URI).
# Obligatorio en Jenkins: el smoke pide tokens vía host.docker.internal.
KEYCLOAK_HOSTNAME=http://localhost:8181
KEYCLOAK_CLIENT_ID=inventory-api
KEYCLOAK_CLIENT_SECRET=inventory-api-secret

# --- API ---
API_HOST_PORT=8088
CORS_ORIGINS=http://localhost:3008
# JWKS interno (red Docker); el issuer sigue siendo el URL público de arriba
JWT_JWK_SET_URI=http://keycloak:8080/realms/inventory/protocol/openid-connect/certs

# --- Frontend (build-time Vite) ---
FRONTEND_HOST_PORT=3008
VITE_API_URL=http://localhost:8088
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=inventory
VITE_KEYCLOAK_CLIENT_ID=inventory-frontend

# --- Observabilidad (puertos host) ---
TEMPO_HOST_PORT=3201
LOKI_HOST_PORT=3101
ALLOY_OTLP_GRPC_PORT=4319
ALLOY_OTLP_HTTP_PORT=4320
ALLOY_UI_PORT=12346
PROMETHEUS_HOST_PORT=9091
ALERTMANAGER_HOST_PORT=9094
GRAFANA_HOST_PORT=3011
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# OTel (API → Alloy en red compose)
OTEL_TRACES_SAMPLING=1.0
OTEL_TRACES_ENDPOINT=http://alloy:4318/v1/traces
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_METRICS_EXPORT_URL=http://alloy:4318/v1/metrics
