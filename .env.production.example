# ENV-03 — Production-like (copiar a .env.production y ajustar). No commitear .env.production.
# Uso:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Sustituir TODOS los change-me-* antes de cualquier uso real.
# En un despliegue real: HTTPS, Keycloak en modo producción y secretos en un vault/CI.

# --- Postgres ---
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-prod-db
POSTGRES_HOST_PORT=5435

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_HOST_PORT=8182
KEYCLOAK_ISSUER_URI=http://localhost:8182/realms/inventory
KEYCLOAK_CLIENT_ID=inventory-api
KEYCLOAK_CLIENT_SECRET=change-me-api-client-secret

# --- API ---
API_HOST_PORT=8089
CORS_ORIGINS=http://localhost:3009
JWT_JWK_SET_URI=http://keycloak:8080/realms/inventory/protocol/openid-connect/certs
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus

# --- Frontend (build-time Vite) ---
FRONTEND_HOST_PORT=3009
VITE_API_URL=http://localhost:8089
VITE_KEYCLOAK_URL=http://localhost:8182
VITE_KEYCLOAK_REALM=inventory
VITE_KEYCLOAK_CLIENT_ID=inventory-frontend

# --- Observabilidad (puertos host; preferible no exponer públicamente) ---
TEMPO_HOST_PORT=3202
LOKI_HOST_PORT=3102
ALLOY_OTLP_GRPC_PORT=4321
ALLOY_OTLP_HTTP_PORT=4322
ALLOY_UI_PORT=12347
PROMETHEUS_HOST_PORT=9092
ALERTMANAGER_HOST_PORT=9095
GRAFANA_HOST_PORT=3012
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# OTel — muestreo bajo por defecto en prod
OTEL_TRACES_SAMPLING=0.1
OTEL_TRACES_ENDPOINT=http://alloy:4318/v1/traces
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_METRICS_EXPORT_URL=http://alloy:4318/v1/metrics
