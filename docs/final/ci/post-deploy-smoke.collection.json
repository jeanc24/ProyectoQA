{
  "info": {
    "name": "ProyectoQA post-deploy smoke (ENV-02)",
    "description": "Colección Newman equivalente a scripts/post-deploy-smoke.sh. Variables: baseUrl, keycloakUrl, clientId, clientSecret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088" },
    { "key": "keycloakUrl", "value": "http://localhost:8181" },
    { "key": "realm", "value": "inventory" },
    { "key": "clientId", "value": "inventory-api" },
    { "key": "clientSecret", "value": "inventory-api-secret" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Token admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password" },
            { "key": "client_id", "value": "{{clientId}}" },
            { "key": "client_secret", "value": "{{clientSecret}}" },
            { "key": "username", "value": "admin" },
            { "key": "password", "value": "admin" }
          ]
        },
        "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().access_token;",
              "pm.collectionVariables.set('adminToken', t);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin list products",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Products without token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
          }
        }
      ]
    }
  ]
}
